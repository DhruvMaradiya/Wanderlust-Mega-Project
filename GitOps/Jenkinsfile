@Library('Shared') _
pipeline {
    agent { label 'gcp' }

    parameters {
        string(
            name: 'FRONTEND_DOCKER_TAG',
            defaultValue: '',
            description: 'Frontend Docker tag of the image built by the CI job'
        )
        string(
            name: 'BACKEND_DOCKER_TAG',
            defaultValue: '',
            description: 'Backend Docker tag of the image built by the CI job'
        )
    }

    stages {
        stage("Workspace cleanup") {
            steps {
                script {
                    cleanWs()
                }
            }
        }

        stage("Git: Code Checkout") {
            steps {
                script {
                    code_checkout(
                        "https://github.com/DhruvMaradiya/Wanderlust-Mega-Project.git",
                        "main"
                    )
                }
            }
        }

        stage("Verify: Docker Image Tags") {
            steps {
                script {
                    echo "FRONTEND_DOCKER_TAG: ${params.FRONTEND_DOCKER_TAG}"
                    echo "BACKEND_DOCKER_TAG: ${params.BACKEND_DOCKER_TAG}"
                }
            }
        }

        stage("Update: Kubernetes manifests") {
            steps {
                script {
                    dir('kubernetes') {
                        sh """
                            sed -i 's|image: .*wanderlust-backend-beta:.*|image: dhruv4810/wanderlust-backend-beta:${params.BACKEND_DOCKER_TAG}|g' backend.yaml
                            sed -i 's|image: .*wanderlust-frontend-beta:.*|image: dhruv4810/wanderlust-frontend-beta:${params.FRONTEND_DOCKER_TAG}|g' frontend.yaml
                        """
                    }
                }
            }
        }

        stage("Git: Code update and push to GitHub") {
            steps {
                script {
                    withCredentials([gitUsernamePassword(credentialsId: 'Github-cred', gitToolName: 'Default')]) {
                        sh '''
                            git config user.email "dhruvmvr@gmail.com"
                            git config user.name "Dhruv Maradiya"

                            echo "Checking repository status: "
                            git status

                            echo "Adding changes to git: "
                            git add .

                            echo "Committing changes: "
                            git commit -m "Updated environment variables" || echo "No changes to commit"

                            echo "Pushing changes to GitHub: "
                            git push https://github.com/DhruvMaradiya/Wanderlust-Mega-Project.git main
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                emailext(
                    attachLog: true,
                    from: 'dhruvmvr@gmail.com',
                    subject: "Wanderlust Application has been updated and deployed - '${currentBuild.result}'",
                    body: """
                        <html>
                        <body>
                            <div style="background-color: #FFA07A; padding: 10px; margin-bottom: 10px;">
                                <p style="color: black; font-weight: bold;">Project: ${env.JOB_NAME}</p>
                            </div>
                            <div style="background-color: #90EE90; padding: 10px; margin-bottom: 10px;">
                                <p style="color: black; font-weight: bold;">Build Number: ${env.BUILD_NUMBER}</p>
                            </div>
                            <div style="background-color: #87CEEB; padding: 10px; margin-bottom: 10px;">
                                <p style="color: black; font-weight: bold;">URL: ${env.BUILD_URL}</p>
                            </div>
                        </body>
                        </html>
                    """,
                    to: 'dhruvmvr@gmail.com',
                    mimeType: 'text/html'
                )
            }
        }

        failure {
            script {
                emailext(
                    attachLog: true,
                    from: 'dhruvmvr@gmail.com',
                    subject: "Wanderlust Application build failed - '${currentBuild.result}'",
                    body: """
                        <html>
                        <body>
                            <div style="background-color: #FFA07A; padding: 10px; margin-bottom: 10px;">
                                <p style="color: black; font-weight: bold;">Project: ${env.JOB_NAME}</p>
                            </div>
                            <div style="background-color: #90EE90; padding: 10px; margin-bottom: 10px;">
                                <p style="color: black; font-weight: bold;">Build Number: ${env.BUILD_NUMBER}</p>
                            </div>
                        </body>
                        </html>
                    """,
                    to: 'dhruvmvr@gmail.com',
                    mimeType: 'text/html'
                )
            }
        }
    }
}
